# ==============================================================================
# CloudPulse Platform Configuration & Secrets Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL
# ==============================================================================

# Environment & Server
ENV=production
PORT=8080
JWT_SECRET=your_32_byte_minimum_production_jwt_signing_secret_here

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/cloudpulse?sslmode=disable

# Redis In-Memory Cache & Concurrency
REDIS_URL=redis://redis:6379/0

# Gateway Ports
GATEWAY_HTTP_PORT=8000
GATEWAY_METRICS_PORT=9100
CONTROL_PLANE_URL=http://backend:8080

# Dynamic Provider Routing
PROVIDER_PRIMARY=residential-authorized
PROVIDER_FALLBACK=provider-a

# Authorized Residential Proxy Provider Configuration
RESIDENTIAL_PROVIDER_ENABLED=true
RESIDENTIAL_PROVIDER_NAME=residential-authorized
RESIDENTIAL_PROVIDER_TYPE=residential
RESIDENTIAL_PROVIDER_GATEWAY_HOST=
RESIDENTIAL_PROVIDER_GATEWAY_PORT=8000
RESIDENTIAL_PROVIDER_USERNAME=
RESIDENTIAL_PROVIDER_PASSWORD=
RESIDENTIAL_PROVIDER_API_KEY=

# Cloudflare Tunnel (For Web Dashboard & REST API)
# Paste your Cloudflare Tunnel token here to establish secure inbound connectivity
CLOUDFLARE_TUNNEL_TOKEN=
